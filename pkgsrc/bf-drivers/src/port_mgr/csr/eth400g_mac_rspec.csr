//##############################################
// Include block specs
//##############################################
#include "templates_rspec.csr"

//##############################################
// Define Global Parameters
//##############################################
property word_size = 4 bytes;

//##############################################
// Define Registers
//##############################################

addressmap {

register eth_soft_reset {
	 property title = "Enable to perform Software reset to different portion of the Ethernet block";
	 property description = "Each bit defines a soft reset functionality which need to be asserted high  "
                                "to generate a software reset of the block. ";
	 property register_reset_value = 0x00000004;
	 field {
	       property title = "Software reset";
	       property description = "Each bit triggers a different software reset or control: \n"
                                      " -[0]     : Reset Comira MAC/PCS \n"
                                      " -[1]     : Reset App logic \n"
                                      " -[2]     : Reset microcontroller";
                property output_port = true;
	 } [2:0] eth_swrst;
};

register eth_clkobs_ctrl {
	 property title = "Clock observation daisy chaining control register";
	 property description = "Control whether the selected is sent through the daisy chain to the Clock Observation pad  ";
	 property register_reset_value = 0x00000000;
	 field {
	       property title = "Enable clock observation on daisy chain 0";
	       property description = "Enables the selected clock obervation selected of the MAC to be sent on the daisy chain up to the clock observation pad ";
               property output_port = true;
	 } [0] ena_clkobs0;
	 field {
	       property title = "Enable clock observation on daisy chain 1";
	       property description = "Enables the selected clock obervation selected of the MAC to be sent on the daisy chain up to the clock observation pad ";
               property output_port = true;
	 } [8] ena_clkobs1;
};

register eth_ring_setup {
	 property title = "Ethernet Ring Setup";
	 property description = "Control whether the selected is sent through the daisy chain to the Clock Observation pad  ";
	 property register_reset_value = 0x0000003F;
	 field {
	       property title = "Select the slot allocated for the port in the GPIO IO ring";
	       property description = "Defines a timeslot associated for the port \n";
               property output_port = true;
	 } [5:0] ring_id;
	 field {
	       property title = "GPIO ring select";
	       property description = "Select GPIO ring 0 or 1";
               property output_port = true;
	 } [8] ring_sel;
};

register eth_ring_addr {
	 property title = "Ethernet Ring Address ";
	 property description = "Ethernet Ring data written during a direct write access";
	 property register_reset_value = 0x00000000;
	 field {
	       property title = "Ethernet Ring Address";
	       property description = "In I2c Mode, the first byte sent over I2C is bit [7:0], followed by [15:8],... \n"
                                      "In MDIO Mode, bit [4:0] defines portaddr[4:0] and bit [12:8] defines devaddr[4:0]. \n"
                                      "In StateOut Mode,this register can be used to write an extra 4B. \n"
                                      "The number of bytes depends on Ethernet Ring Control settings.  ";
	       property output_port = true;
	 } [31:0] addr;
};

register eth_ring_wdata {
	 property title = "Ethernet Ring Write data ";
	 property description = "Ethernet Ring data written during a direct write access";
	 property register_reset_value = 0x00000000;
	 field {
	       property title = "Ethernet Ring Write data";
	       property description = "Data written during a direct write access. The first byte sent over I2C is bit [7:0]."
                                      " The number of byte written depends on ethernet ring control register settings. ";
	       property output_port = true;
	 } [31:0] wdata;
};

register eth_ring_rdata {
	 property title = "Ethernet Ring read data";
	 property description = "Report up to 4 byte data read from Ethernet GPIO block";
	 property register_reset_value = 0x0000000;
	 field {
	       property title = "Ring read data";
	       property description = "Report the 4 byte data read on I2C/MDIO interface during a register read. "
                                      "first byte read is on bit [7:0],...";
               property load_enable = true;
               property input_value = true;
	 } [31:0] rdata;
};


register eth_ring_ctrl {
	 property title = "Ethernet Ring Control ";
	 property description = "Ethernet Ring Control";
	 property register_reset_value = 0x00000000;
	 field {
	       property title = "Ethernet Ring typerequest register";
	       property description = "Defines the type of transaction to be performed: \n"
                                      " - 00b : Idle \n"
                                      " - 01b : I2C transaction \n"
                                      " - 10b : MDIO transaction \n"
                                      " - 11b : StateOut \n"
                                      "This register get cleared back to 00b when transaction has been issued to the ethernet GPIO block."
                                      "Refer to the Status register to see status of the current transaction" ;
	       property output_port = true;
               property input_value = true;
               property load_enable = true;
	 } [1:0] req_type;
	 field {
	       property title = "Command";
	       property description = "In I2C mode, defines which command:\n"
                                      " - 00b : write address and write data command \n"
                                      " - 01b : write address and read data \n"
                                      " - 10b : write device address only\n"
                                      " - 11b : read data only \n";
 	       property output_port = true;
	 } [3:2] cmd;
	 field {
	       property title = "Number of address byte";
	       property description = "In I2C mode, defines the number of address bytes (0-4) to transfer after the device address byte. \n"
                                      "In MDIO mode, contains the MDIO transaction code (on bit [1:0]) and transaction type (on bit [2]) \n"
                                      "In StateOut mode, this field is reserved";
 	       property output_port = true;
	 } [6:4] addrnum;
	 field {
	       property title = "Device address";
	       property description = "In I2C mode, bit [6:0] defines the device address of the I2C device to target. \n"
                                      "On StateOut mode, bit [7:0] defines the start address of the StateOut transfer. ";
	       property output_port = true;
	 } [15:8] devaddr;
	 field {
	       property title = "Number of data phase";
	       property description = "For I2C mode, maximum number of byte is 4"
                                      "For MDIO mode, \n"
                                      "In StateOut mode, maximum 8B can be transferred \n";
	       property output_port = true;
	 } [19:16] datanum;
	 field {
	       property title = "Lock mode";
	       property description = "Transaction ";
 	       property output_port = true;
	 } [20] lock_req;
	 field {
	       property title = "GPIO group ID";
	       property description = "Defines which GPIO group/pair is targeted by the transaction. Value value are 0-5."
                                      " It is assumed that the GPIO pair targeted is programmed in expected mode for I2C and MDIO settings. ";
 	       property output_port = true;
	 } [23:21] gpio_id;
	 field {
	       property title = "Transaction Status";
	       property description = "Defines the status of the on-going transaction: \n"
                                      " - 000b: No update \n"
                                      " - 001b: Request sent to GPIO block. \n"
                                      " - 010b: Request granted by GPIO block. \n"
                                      " - 011b: Response received from GPIO block with no error. \n"
                                      " - 101b: Response received from GPIO block with error.";
               property load_enable = true;
               property input_value = true;
	 } [26:24] status;
	 field {
	       property title = "Lock Error";
	       property description = "Register get set when lock error status is received. Lock error bit need to be cleared by hardware.";
	       property output_port = true;
               property input_value = true;
               property load_enable = true;
	 } [28] lock_err;
};


register soft_port_alive {
	 property title = "Software port alive";
	 property description = "Contain the software-controlled port_alive entry";
	 property register_reset_value = 0x0000000;
	 field {
	       property title = "Software port alive";
	       property description = "Defines the software-controlled port_alive entry (1 bit per channel), going to the Look-Up Table"
                                      " to create the final port_alive signal which will be sent to PGR block.";
	       property output_port = true;
	 } [7:0] val;
};



register eth_onestep_ets_offset_ctrl {
	 property title = "Defines the offset used for One Step Egress Timestamping";
	 property description = "The offset is added to the MAC layer timestamp to compute the "
                                "correction field of the packet transmitted marked as egress timestamping. ";
	 property register_reset_value = 0x00000000;
         property atomic_access = "lsb_read_msb_write";
	 field {
	       property title = "One Step Egress Timestamping offset";
	       property description = "Offset which is added to timestamp during egress timestamping and"
                                      "which need to account for full MAC/PCS layer latency. \n"
                                      "Note that increment/drift is received from MBus Station as"
                                      "the logic works on CoreClk. ";
               property output_port = true;
	 } [47:0] eth_onestep_ets_offset;
	 field {
	       property title = "One Step Egress Timestamping Tx fifo adjust ";
	       property description = "Adjust the Egress timestamping offset by the current Tx app fifo count multiply by"
                                      " the adjustment factor (6 lsb represent nanosecond and 10 lsb represent fractional nanosecond)";
               property output_port = true;
	 } [63:48] eth_onestep_ets_txff_cnt_adj;
};

register eth_mac_ts_offset_ctrl {
	 property title = "Defines the offset/increment used for MAC Timestamping";
	 property description = "Control the MAC layer ingress timestamping and egress timestamping "
                                "(capture TS on transmit) ";
	 property register_reset_value = 0x00000000;
         property atomic_access = "lsb_read_msb_write";
	 field {
	       property title = "MAC Layer Timestamping offset";
	       property description = "Offset which is added to timestamp received from MBus Station";
               property output_port = true;
	 } [47:0] eth_mac_ts_offset;
	 field {
	       property title = "MAC Timestamping Increment";
	       property description = "Increment/Drift on MAC clock to automatically increment timestamp every"
                                      "MAC clock cycle (4 lsb represent ns and 12 lsb represent ps)";
               property output_port = true;
	 } [63:48] eth_mac_ts_incr;
};

register eth_status0 {
	 property title = "Ethernet Status";
	 property description = "Report Status Bits of the MAC block";
	 property register_reset_value = 0x0000000;
	 field {
	       property title = "MAC local fault status";
	       property description = "Report the local fault status of the MAC (per channel)";
	       property field_type = "status";
               property input_value = true;
	 } [7:0] macsts_lfault;
	 field {
	       property title = "MAC remote fault status";
	       property description = "Report the remote fault status of the MAC (per channel)";
	       property field_type = "status";
               property input_value = true;
	 } [15:8] macsts_rfault;
	 field {
	       property title = "MAC local/remote ORed fault status";
	       property description = "Report the ORed local/remote fault status of the MAC (per channel)";
	       property field_type = "status";
               property input_value = true;
	 } [23:16] macsts_ofault;
	 field {
	       property title = "MAC link up status";
	       property description = "Report the link up status of the MAC (per channel)";
	       property field_type = "status";
               property input_value = true;
	 } [31:24] macsts_linkup;
};

register eth_status1 {
	 property title = "Ethernet Status 1";
	 property description = "Report Status Bits of the MAC block";
	 property register_reset_value = 0x0000000;
	 field {
	       property title = "MAC Signal OK status";
	       property description = "Report the Signal OK status of the MAC (per channel)";
	       property field_type = "status";
               property input_value = true;
	 } [7:0] macsts_sigok;
	 field {
	       property title = "MAC Tx Idle status";
	       property description = "Report the Tx Idle status of the MAC (per channel)";
	       property field_type = "status";
               property input_value = true;
	 } [15:8] macsts_txidle;
	 field {
	       property title = "MAC Rx Idle status";
	       property description = "Report the Rx Idle status of the MAC (per channel)";
	       property field_type = "status";
               property input_value = true;
	 } [23:16] macsts_rxidle;
	 field {
	       property title = "MAC Tx Good status";
	       property description = "Report the Tx good status of the MAC (per channel)";
	       property field_type = "status";
               property input_value = true;
	 } [31:24] macsts_txgood;
};

register chnl_seq {
	 property title = "Channel Sequencing control register";
	 property description = "Defines 8 slots of Time Domain Multiplexing Each slot correspodning to one channel. \n"
	                        "The channel sequencing need to follow the throughput rule of 1 slot per 50G of throughput, spaced in time appropriately.";
	 property register_reset_value = 0x00000000;
	 field {
	       property title = "Channel Sequence";
	       property description = "Each 3-bit correspond to a channel slot. By default, each 50G channel has one time slot and must be sequenced as follow 0,4,2,6,1,5,3,7 (0xEE9CA0). When any channel is configured in 100G, 200G or 400G mode, it consumes the slot of the next channels (up to creating teh required number of timeslot. Those timeslot are fixed and should not be modified for the channels which are not reconfigured. A 100G channel requires 2 timeslots every 4 clock cycles. A 200G channel requires 4 timeslot every 2 clock cycles. A 400G channel requires 8 timeslot every clock cycle. Common configuration are as follow: \n"
                                      " - 1x400G : 0x000000 \n"
                                      " - 2x200G : 0x820820 \n"
                                      " - 4x100G : 0xCA0CA0 \n"
                                      " - 8x50G  : 0xEE9CA0 \n";
	       property output_port = true;
	 } [23:0] chnl_seq;
	 field {
	       property title = "Select Egress Buffer sequencing";
	       property description = "Can be set dynamically before transmitting data to use the egress buffer sequencing";
	       property output_port = true;
	 } [31] sel_buf_seq;
};

register txff_ctrl {
	 property title = "Transmit fifo Control (per channel)";
	 property description = "Defines the Tx fifo control register on a per channel basis";
	 property register_reset_value = 0x00000000;
	 field {
	       property title = "Channel Enable";
	       property description = "Enable Tx fifo for traffic";
	       property output_port = true;
	 } [0] chnl_ena;
	 field {
	       property title = "Flush Tx fifo";
	       property description = "when set, put the Tx fifo in flush mode, discarding any new packet coming from Egress Buffer";
	       property output_port = true;
	 } [1] tx_flush;
	 field {
	       property title = "Channel Mode";
	       property description = "Define the channel configuration as follow: \n"
                                      " - 00b: 400G Mode (channel 0 only) \n"
                                      " - 01b: 200G Mode (channel 0/4 only) \n"
                                      " - 10b: 100G Mode (channel 0/2/4/6 only) \n"
                                      " - 11b: 50G  Mode (any channel) \n";
	       property output_port = true;
	 } [3:2] chnl_mode;
	 field {
	       property title = "Pause XOFF mode";
	       property description = "This register need to be set when the MAC workis configured in Pause XOFF mode (not PFC mode). In that mode, the MAC reports RX_XOFF "
                                      "through PFC_XOFF[0] signal and that is translated through asserting all 8 RX_PFCXOFF signals to the Core.";
	       property output_port = true;
	 } [4] rx_xoff_mode;
	 field {
	       property title = "Override Rx PFC XOFF Control";
	       property description = "when set, replace the Rx PFC XOFF received and extracted by the MAC by a fix value provided by the register space";
	       property output_port = true;
	 } [5] ovr_rx_pfcxoff;
	 field {
	       property title = "Enable Transmit to Rx loopback immediately after the Tx fifo (min latency)";
	       property description = "when set, loopback the Tx data (from Egress Buffer) back to Rx (to Ingress Parser Buffer)";
	       property output_port = true;
	 } [6] txrx_lpbk;
	 field {
	       property title = "Override Rx PFC XOFF Value";
	       property description = "Defines the value of Rx PFC XOFF when provided by the register space (one bit per PFC)";
	       property output_port = true;
	 } [15:8] val_rx_pfcxoff;
	 field {
	       property title = "Initial Credit with Egress Buffer";
	       property description = "Defines the amount of credit to send to Egress Buffer when channel get enabled (one credit is equivalent to 16B data payload)";
	       property output_port = true;
	 } [22:16] cred_ini;
	 field {
	       property title = "Forwarding minimum threshold check";
	       property description = "Defines the number of 16B data payload to be accumulated on a start of packet before forwarding the packet to the Tx MAC.";
	       property output_port = true;
	 } [30:24] min_thr;
};

register txff_status {
	 property title = "Ethernet Transmit Fifo Status";
	 property description = "Report Status Bits of the Transmit fifo";
	 property register_reset_value = 0x0000000;
	 field {
	       property title = "PFC XOFF status from MAC layer";
	       property description = "Report the Rx PFC XOFF reported by the MAC layer";
	       property field_type = "status";
               property input_value = true;
	 } [7:0] pfc_rxxoff;
	 field {
	       property title = "Tx fifo count (per channel)";
	       property description = "Report the Tx fifo current count in 16B increment";
	       property field_type = "status";
               property input_value = true;
	 } [17:8] txff_count;
	 field {
	       property title = "Tx app fifo count (per channel)";
	       property description = "Report the Tx application fifo current count in 64B increment";
	       property field_type = "status";
               property input_value = true;
	 } [31:24] txappfifo_count;
};


register rxff_ctrl {
	 property title = "Receive fifo Control (per channel)";
	 property description = "Defines the Rx fifo control register on a per channel basis";
	 property register_reset_value = 0x00000000;
	 field {
	       property title = "CRC generation disable";
	       property description = "when set, globally disable the internal CRC regeneration from the MAC layer";
	       property output_port = true;
	 } [0] crcgen_dis;
	 field {
	       property title = "CRC generation disable on error";
	       property description = "when set, disable the internal CRC regeneration from the MAC layer only for frames received with error";
	       property output_port = true;
	 } [1] crcerr_dis;
	 field {
	       property title = "Enable Tx XOFF in Tx PFC mode";
	       property description = "when set, assert all PFC XOFF bits when Tx XOFF is received from the core of the chip for that channel";
	       property output_port = true;
	 } [4] en_tx_xoff;
	 field {
	       property title = "Override Tx PFC XOFF Control";
	       property description = "when set, replace the Tx PFC XOFF received from Core side and sent to the MAC by a fix value provided by the register space";
	       property output_port = true;
	 } [5] ovr_tx_pfcxoff;
	 field {
	       property title = "Tx Pause XOFF mode";
	       property description = "This register need to be set when the MAC is configured in Pause Frame mode. In that mode, any of the 8 Tx PFC XOFF (if enable)"
                                      " or Tx XOFF received from the core will be translated as a Pause Frame.";
	       property output_port = true;
	 } [6] tx_xoff_mode;
	 field {
	       property title = "Tx PFC enable in Tx Pause XOFF mode";
	       property description = "In Tx Pause frame mode, this register defines if XOFF is sent to MAC layer if any of the Tx PFC XOFF bit "
                                      " or Tx XOFF received from the core will be translated as a Pause Frame.";
	       property output_port = true;
	 } [7] en_tx_pfc_xoff_mode;
	 field {
	       property title = "Override Tx PFC XOFF Value";
	       property description = "Defines the value of Tx PFC XOFF when provided by the register space (one bit per PFC)";
	       property output_port = true;
	 } [15:8] val_tx_pfcxoff;
	 field {
	       property title = "Enable Tx PFC XOFF ";
	       property description = "Enable each Tx PFC XOFF (one bit per PFC) to be sent to MAC layer";
	       property output_port = true;
	 } [23:16] en_tx_pfcxoff;
};



register txcrc_trunc_ctrl {
	 property title = "Transmit path packet CRC check and truncation control";
	 property description = "Control the Tx path CRC check and truncation feature of the packet";
	 property register_reset_value = 0x00000000;
	 field {
	       property title = "CRC checker disable";
	       property description = "when set, globally disable the internal CRC checker from the MAC layer";
	       property output_port = true;
	 } [0] crcchk_dis;
	 field {
	       property title = "CRC checker disable on error and do not remove the 4B CRC";
	       property description = "when set, disable the internal CRC checker and do not remove the 4B CRC before sending to the Tx MAC layer (MAC should be dynamically controlled to not generate Tx CRC.";
	       property output_port = true;
	 } [1] crcerr_dis;
	 field {
	       property title = "CRC generation disable on error";
	       property description = "when set, disable the internal CRC regeneration from the MAC layer only for frames received with error";
	       property output_port = true;
	 } [2] crcrmv_dis;
	 field {
	       property title = "Truncation enable";
	       property description = "Enable packet truncation for that channel";
	       property output_port = true;
	 } [3] trunc_ena;
	 field {
	       property title = "Truncation size";
	       property description = "Report the size in byte for truncating packet. "
                                      "Truncated packet will have valid CRC32 independantly of the CRC received from Deparser.";
	       property output_port = true;
	 } [29:16] trunc_size;
};

register rxpkt_err_sts {
	 property title = "Rx Packet Error Status capture";
	 property description = "Capture the Rx status of last error packet received";
	 property register_reset_value = 0x00000000;
	 field {
	       property title = "Rx Packet Error Status capture";
	       property description = "Capture the Rx status of last error packet received";
	       property field_type = "status";
               property input_value = true;
	 } [31:0] last_rxsts;
};

register cts_fifo_stat {
	 property title = "Capture timestamp (two-step) fifo status";
	 property description = "Report two-step timestamp fifo count of all 8 channels";
	 property register_reset_value = 0x00000000;
	 field {
	       property title = "Wwo-step timestamp fifo count of channel 0";
	       property description = "report the number of entry in fifo (max 4)";
	       property field_type = "status";
               property input_value = true;
	 } [2:0] count0;
	 field {
	       property title = "Wwo-step timestamp fifo count of channel 1";
	       property description = "report the number of entry in fifo (max 4)";
	       property field_type = "status";
               property input_value = true;
	 } [6:4] count1;
	 field {
	       property title = "Wwo-step timestamp fifo count of channel 2";
	       property description = "report the number of entry in fifo (max 4)";
	       property field_type = "status";
               property input_value = true;
	 } [10:8] count2;
	 field {
	       property title = "Wwo-step timestamp fifo count of channel 3";
	       property description = "report the number of entry in fifo (max 4)";
	       property field_type = "status";
               property input_value = true;
	 } [14:12] count3;
	 field {
	       property title = "Wwo-step timestamp fifo count of channel 4";
	       property description = "report the number of entry in fifo (max 4)";
	       property field_type = "status";
               property input_value = true;
	 } [18:16] count4;
	 field {
	       property title = "Wwo-step timestamp fifo count of channel 5";
	       property description = "report the number of entry in fifo (max 4)";
	       property field_type = "status";
               property input_value = true;
	 } [22:20] count5;
	 field {
	       property title = "Wwo-step timestamp fifo count of channel 6";
	       property description = "report the number of entry in fifo (max 4)";
	       property field_type = "status";
               property input_value = true;
	 } [26:24] count6;
	 field {
	       property title = "Wwo-step timestamp fifo count of channel 7";
	       property description = "report the number of entry in fifo (max 4)";
	       property field_type = "status";
               property input_value = true;
	 } [30:28] count7;
};

register cts_fifo_out {
	 property title = "Two-step Timestamp fifo output content";
	 property description = "Report the first entry of the two-step timestamp.";
	 property register_reset_value = 0x00000000;
	 property register_accessed_port = true;
         property atomic_access = "lsb_read_msb_write";
         property read_access = true;
         property write_access = false;
	 field {
	       property title = "Two-step Timestamp fifo output content";
	       property description = "When the fifo is empty return 0x0, otherwise return: \n"
                                      " - [47:0] : Capture timestamp \n"
                                      " - [56:48]: Timestamp ID (9-bit self incrementing allowing to number of lost ID) \n"
                                      " - [62:57]: Reserved \n"
                                      " - [63]   : Valid entry when set to 1 ";
	       property field_type = "status";
               property input_value = true;
	 } [63:0] cts;
};

register port_alive_lut {
	 property title = "Defines the Port Alive LUT programming";
	 property description = "Allow to flexibly map rxsigok, txgood, rxsync, ext_rxsigok and ofault to generate port_alive to packet gen and TM ";
	 property register_reset_value = 0xAAAAAAAA;
         property register_output_port = true;
	 field {
	       property title = "Defines the Port Alive LUT programming";
	       property description = "Allow to flexibly map internal status to generate port_alive status for TM and packet generator : \n"
                                      " port_alive = port_alive_lut[{ofault,ext_rxsigok,rxsigok,txgood,rxsync}] \n"
                                      " Thus if only rxsync contributes to port_alive, programming is 16'hAAAA.";
	 } [31:0] port_alive_lut;
};

register global_intr_stat {
	 property title = "Global Interrupt Status";
	 property description = "Global Interrupt Status which redirect to MAC interrupt, Channel interrupt or Memory interrupt";
	 property register_reset_value = 0x00000000;
	 field {
	       property title = "Global Low-priority Interrupt Status";
	       property description = "Report which interrupt register is asserted: \n"
                                      " - bit 0 : Channel interrupt \n"
                                      " - bit 1 : Memory interrupt \n"
                                      " - bit 2 : Two-step timestamp interrupt \n"
                                      " - bit 3 : MAC interrupt \n"
                                      " - bit 4 : PCS memory interrupt \n "
                                      " - bit 5 : MDIOCI interrupt \n "
                                      " - bit 6 : Microcontroller interrupt. ";
	       property field_type = "status";
               property input_value = true;
	 } [6:0] intr_lo_stat;
	 field {
	       property title = "Global High-priority Interrupt Status";
	       property description = "Report which interrupt register is asserted: \n"
                                      " - bit 0 : Channel interrupt \n"
                                      " - bit 1 : Memory interrupt \n"
                                      " - bit 2 : Two-step timestamp interrupt "
                                      " - bit 3 : MAC interrupt \n"
                                      " - bit 4 : PCS memory interrupt \n "
                                      " - bit 5 : MDIOCI interrupt \n "
                                      " - bit 6 : Microcontroller interrupt. ";
	       property field_type = "status";
               property input_value = true;
	 } [14:8] intr_hi_stat;
};


register crcerr_inj {
	 property title = "CRC error Injection Register";
	 property description = "CRC error injection on Rx path, set interrupt and self-clear; \n"
	                        "Each bit generate a single CRC error for one channel as if reported by MAC";
	 property register_reset_value = 0x00000000;
	 field {
	       property title = "Interrupt injection";
	       property description = "Inject a crc error for each channel";
	       property output_port = true;
               property load_enable = true;
               property input_value = true;	       
	 } [7:0] inj;
};


register tv80_debug_ctrl {
	 property title = "TV80 debug fifo base and limit address";
	 property description = "Debug fifo base/limit addresses and enable bit which memorize all register Rd/Wr transactions performed by the TV80 microcontroller. "
                                "The debug fifo is implemented in the microcontroller SRAM allowingportion which is not allocated by SW for firmware or user data. \n "
                                "Each fifo entry corresponds to two addresses of the microcontroller SRAM where the : \n"
                                " -first  address bit[17:0] : Byte address of the transaction \n"
                                " -first  address bit[30]   : Error during transaction acknowledge phase \n"
                                " -first  address bit[31]   : Read (1b) / Write (0b) \n"
                                " -second address bit[31:0] : Write data or read data ";
	 property register_reset_value = 0x00000000;
	 field {
	       property title = "Base address of debug fifo";
	       property description = "Define the base address of debug fifo structure";
	       property output_port = true;
	 } [11:0] base_addr;
	 field {
	       property title = "Limit address of debug fifo";
	       property description = "Define the limit address of debug fifo structure";
	       property output_port = true;
 	 } [23:12] limit_addr;
	 field {
	       property title = "Log register transaction generated by TV80";
	       property description = "When set, the debug buffer will capture all register transactions generated by TV80. "
                                      "Each instruction will be 32-bit quanta and will logged as follow:  : \n"
                                      " -first  address bit[31:30] : Instruction code (00b for register access) \n"
                                      " -first  address bit[29]    : Error during transaction acknowledge phase \n"
                                      " -first  address bit[28]    : Read (1b) / Write (0b) \n"
                                      " -first  address bit[27:0]  : Word address of the transaction \n"
                                      " -second address bit[31:0]  : Write data or read data ";
	       property output_port = true;
 	 } [25] log_reg;
	 field {
	       property title = "Log instruction";
	       property description = "When set, the debug buffer will capture all instruction and data read by the microcontroller. "
                                      "Each instruction will be 32-bit quanta and will logged as follow:  \n"
                                      " - bit[31:30] : Instruction Code (11b) \n"
                                      " - bit[29]    : M1 cycle  \n"
                                      " - bit[28]    : Read (1b) / Write (0b)  \n"
                                      " - bit[23:16] : Data  \n"
                                      " - bit[13:0]  : Address  \n";
	       property output_port = true;
 	 } [26] log_inst;
	 field {
	       property title = "Fifo Mode";
	       property description = "When set, the debug buffer works in fifo mode which stalls automatically when fifo is full. "
                                      " When cleared, the fifo works in circular buffer mode, overriding the oldest instruction executed.";
	       property output_port = true;
 	 } [29] fifomode;
	 field {
	       property title = "Debug fifo interrupt on full";
	       property description = "When set, assert an interrupt when debug fifo get full. It is only applicable if debug works in fifo mode and not in circular buffer";
	       property output_port = true;
 	 } [30] full_int;
	 field {
	       property title = "Debug fifo enable";
	       property description = "when set, enable the debug fifo structure";
	       property output_port = true;
 	 } [31] enable;
};

register tv80_debug_tail_ptr {
	 property title = "TV80 debug fifo tail pointer";
	 property description = "Debug fifo tail pointer which is automatically updated by the microcontroller logic when a new entry is written inside the fifo. ";
	 property register_reset_value = 0x00000000;
	 field {
	       property title = "Tail address of debug fifo";
	       property description = "Define the current write address of debug fifo structure";
	       property field_type = "status";
               property input_value = true;
	 } [11:0] tail_ptr;
};

register tv80_debug_head_ptr {
	 property title = "TV80 debug fifo head pointer";
	 property description = "Defines the head address of the fifo structure. The head address is updated by SW when fifo entries are read by SW.";
	 property register_reset_value = 0x00000000;
	 field {
	       property title = "Head pointer of debug fifo";
	       property description = "Define the current read address of the debug fifo";
	       property output_port = true;
	 } [11:0] head_ptr;
};

register tv80_watchdog_ctrl {
	 property title = "TV80 watchdog time out and enable";
	 property description = "Defines the TV80 watchdog timer that is required to be cleared by TV80 or an NMI interrupt will be triggered.";
	 property register_reset_value = 0x00000000;
	 field {
	       property title = "Watchdog Timeout value";
	       property description = "Define the maximum of the timeout counter.";
	       property output_port = true;
	 } [30:0] timeout_value;
	 field {
	       property title = "Watchdog Timeout Enable";
	       property description = "Enables the watchdog timeout mechanism to trigger NMI.";
	       property output_port = true;
	 } [31] enable;
};

register tv80_watchdog_count {
	 property title = "TV80 watchdog counter";
	 property description = "Report the current value of the TV80 Watchdog Counter. Can be written back to 0 by TV80 to reset the watchdog timer."
                                "Counter increment by 1 every clock (Clock BPS ~1.35 GHz) when enabled";
	 property register_reset_value = 0x00000000;
	 field {
	       property title = "Watchdog Timeout value";
	       property description = "Define the maximum of the timeout counter.";
	       property output_port = true;
               property load_enable = true;
               property input_value = true;	       
	 } [30:0] cur_time;
};

register tv80_stall_on_error {
	 property title = "TV80 stall on error";
	 property description = "This register defines whether the TV80 get automatically stalled when register access or memory dual-bit error."
                                " The corresponding interrupt is sent to PCIe which will be in charge of clearing the interrupt. When interrupt get cleared,"
                                " TV80 will resume (except if reset or INT/NMI is generated). Settings those registers will prevent TV80 to continue"
                                " operating in case of critical error detected.";
	 property register_reset_value = 0x00000000;
	 field {
	       property title = "Stall command";
	       property description = "When set, the  microcontroller code execution is halted through the logic "
                                      "does not responding to TV80 trying to read the next instruction from its firmware located in SRAM."
                                      " SW will have to clear this bit to enable TV80 to resume its operation.";
	       property output_port = true;
 	 } [0] stall_absolute;
	 field {
	       property title = "Stall on memory multi-bit ECC error";
	       property description = "When set, the TV80 will be stalled when a memory multi-bit error is detected on its own SRAM containing data/firmware. SW will have to clear this bit to enable TV80 to resume its operation.";
	       property output_port = true;
	 } [1] stall_on_mbe;
	 field {
	       property title = "Stall on error for register access generated by TV80 ";
	       property description = "When set, the TV80 will be stalled when a read error transaction generated by TV80.";
	       property output_port = true;
	 } [2] stall_on_rerr;
};

register tv80_halted_status {
	 property title = "TV80 halted status";
	 property description = "Status register reporting that the TV80 microcontroller has been halted.";
	 property register_reset_value = 0x00000000;
	 field {
	       property title = "TV80 halted status";
	       property description = "Status register reporting that the TV80 microcontroller has been halted.";
	       property field_type = "status";
               property input_value = true;
	 } [0] tv80_halted;
};


register eth_mdioci_addr {
	 property title = "Defines indirect mapped address space of the Serdes IO Tile register space";
	 property description = "When accessing Serdes IO Tile register, the address field is 24-bit but only 4k registers per Serdes are directly mapped "
                                "This register defines indirect mapping from 16-bit to 24-bit for MBus access and TV80 access";
	 property register_reset_value = 0x00000000;
	 field {
	       property title = "CPU access static address bits through MBus";
	       property description = "Define the static address bits of the address sent to Serdes IO Tile register interface from the CPU (MBus):\n"
                                      "-bit [3:0] : corresponds to address bits [15:12] of Serdes IO Tile register interface (defines pages of 4K register) \n"
                                      "-bit [7:4] : corresponds to address bits [22:19] of Serdes IO Tile register interface (Serdes ID bit [6:3] should be 0) \n";
               property output_port = true;
	 } [7:0] cpu_addrreg;
};


