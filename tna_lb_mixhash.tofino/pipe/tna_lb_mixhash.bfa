parser ingress:
  start: $init_match
  init_zero: [ B5, H13, W1, W3, B0, H7, H8, B4, H2, H4, W7, B7 ]
  bitwise_or: [ B7 ]
  hdr_len_adj: 16
  states:
    $init_match:
      *:
        load: { half : 0..1, byte0 : 16, byte1 : 17 }
        buf_req: 18
        next: $entry_point.start
    $entry_point.start:
      match: [ half, byte0, byte1 ]
      0b*******0010001001011111100000001:
        0..1: H12  # bit[7..15] -> H12 bit[8..0]: ingress::ig_intr_md.ingress_port
        shift: 16
        buf_req: 16
        next: parse_reorder_digest
      0x********:
        0..1: H12  # bit[7..15] -> H12 bit[8..0]: ingress::ig_intr_md.ingress_port
        load: { half : 28..29 }
        shift: 16
        buf_req: 30
        next: parse_ethernet
    parse_reorder_digest:
      *:
        0..1: H11  # ingress::hdr.reorder_digest.magic
        2..3: H3  # ingress::hdr.reorder_digest.flow_hash
        4..5: H6  # ingress::hdr.reorder_digest.seq
        6: B1  # ingress::hdr.reorder_digest.recirc_count
        7: B6  # ingress::hdr.reorder_digest.reserved
        B7: 1  # value 1 -> B7 bit[0]: ingress::hdr.reorder_digest.$valid
        load: { half : 20..21 }
        shift: 8
        buf_req: 22
        next: parse_ethernet
    parse_ethernet:
      match: [ half ]
      0x0800:
        0..1: H9  # ingress::hdr.ethernet.dst_addr[47:32].32-47
        2..5: W4  # ingress::hdr.ethernet.dst_addr[31:0].0-31
        6..7: H10  # ingress::hdr.ethernet.src_addr[47:32].32-47
        8..11: W5  # ingress::hdr.ethernet.src_addr[31:0].0-31
        12..13: TH3  # ingress::hdr.ethernet.ether_type
        B7: 2  # value 1 -> B7 bit[1]: ingress::hdr.ethernet.$valid
        load: { byte1 : 23 }
        shift: 14
        buf_req: 24
        next: parse_ipv4
      0x0806:
        0..1: H9  # ingress::hdr.ethernet.dst_addr[47:32].32-47
        2..5: W4  # ingress::hdr.ethernet.dst_addr[31:0].0-31
        6..7: H10  # ingress::hdr.ethernet.src_addr[47:32].32-47
        8..11: W5  # ingress::hdr.ethernet.src_addr[31:0].0-31
        12..13: TH3  # ingress::hdr.ethernet.ether_type
        B7: 2  # value 1 -> B7 bit[1]: ingress::hdr.ethernet.$valid
        load: { half : 20..21 }
        shift: 14
        buf_req: 22
        next: parse_arp
      0x****:
        0..1: H9  # ingress::hdr.ethernet.dst_addr[47:32].32-47
        2..5: W4  # ingress::hdr.ethernet.dst_addr[31:0].0-31
        6..7: H10  # ingress::hdr.ethernet.src_addr[47:32].32-47
        8..11: W5  # ingress::hdr.ethernet.src_addr[31:0].0-31
        12..13: TH3  # ingress::hdr.ethernet.ether_type
        B7: 2  # value 1 -> B7 bit[1]: ingress::hdr.ethernet.$valid
        shift: 14
        buf_req: 14
        next: end
    parse_ipv4:
      match: [ byte1 ]
      0x06:
        0..3: TW0
            # - bit[0..3] -> TW0 bit[31..28]: ingress::hdr.ipv4.version
            # - bit[4..7] -> TW0 bit[27..24]: ingress::hdr.ipv4.ihl
            # - bit[8..15] -> TW0 bit[23..16]: ingress::hdr.ipv4.diffserv
            # - bit[16..31] -> TW0 bit[15..0]: ingress::hdr.ipv4.total_len
        4..5: H5  # ingress::hdr.ipv4.identification
        6..7: TH0
            # - bit[48..50] -> TH0 bit[15..13]: ingress::hdr.ipv4.flags
            # - bit[51..63] -> TH0 bit[12..0]: ingress::hdr.ipv4.frag_offset
        8: B2  # ingress::hdr.ipv4.ttl
        9: TB0  # ingress::hdr.ipv4.protocol
        10..11: TH4  # ingress::hdr.ipv4.hdr_checksum
        12..15: W0  # ingress::hdr.ipv4.src_addr
        16..19: W6  # ingress::hdr.ipv4.dst_addr
        B7: 4  # value 1 -> B7 bit[2]: ingress::hdr.ipv4.$valid
        shift: 20
        buf_req: 20
        next: parse_tcp
      0x11:
        0..3: TW0
            # - bit[0..3] -> TW0 bit[31..28]: ingress::hdr.ipv4.version
            # - bit[4..7] -> TW0 bit[27..24]: ingress::hdr.ipv4.ihl
            # - bit[8..15] -> TW0 bit[23..16]: ingress::hdr.ipv4.diffserv
            # - bit[16..31] -> TW0 bit[15..0]: ingress::hdr.ipv4.total_len
        4..5: H5  # ingress::hdr.ipv4.identification
        6..7: TH0
            # - bit[48..50] -> TH0 bit[15..13]: ingress::hdr.ipv4.flags
            # - bit[51..63] -> TH0 bit[12..0]: ingress::hdr.ipv4.frag_offset
        8: B2  # ingress::hdr.ipv4.ttl
        9: TB0  # ingress::hdr.ipv4.protocol
        10..11: TH4  # ingress::hdr.ipv4.hdr_checksum
        12..15: W0  # ingress::hdr.ipv4.src_addr
        16..19: W6  # ingress::hdr.ipv4.dst_addr
        B7: 4  # value 1 -> B7 bit[2]: ingress::hdr.ipv4.$valid
        shift: 20
        buf_req: 20
        next: parse_udp
      0x**:
        0..3: TW0
            # - bit[0..3] -> TW0 bit[31..28]: ingress::hdr.ipv4.version
            # - bit[4..7] -> TW0 bit[27..24]: ingress::hdr.ipv4.ihl
            # - bit[8..15] -> TW0 bit[23..16]: ingress::hdr.ipv4.diffserv
            # - bit[16..31] -> TW0 bit[15..0]: ingress::hdr.ipv4.total_len
        4..5: H5  # ingress::hdr.ipv4.identification
        6..7: TH0
            # - bit[48..50] -> TH0 bit[15..13]: ingress::hdr.ipv4.flags
            # - bit[51..63] -> TH0 bit[12..0]: ingress::hdr.ipv4.frag_offset
        8: B2  # ingress::hdr.ipv4.ttl
        9: TB0  # ingress::hdr.ipv4.protocol
        10..11: TH4  # ingress::hdr.ipv4.hdr_checksum
        12..15: W0  # ingress::hdr.ipv4.src_addr
        16..19: W6  # ingress::hdr.ipv4.dst_addr
        B7: 4  # value 1 -> B7 bit[2]: ingress::hdr.ipv4.$valid
        shift: 20
        buf_req: 20
        next: end
    parse_tcp:
      *:
        0..3: W2
            # - bit[0..15] -> W2 bit[31..16]: ingress::hdr.tcp.src_port
            # - bit[16..31] -> W2 bit[15..0]: ingress::hdr.tcp.dst_port
        4..5: TH2  # ingress::hdr.tcp.seq_no[31:16].16-31
        6..7: TH1  # ingress::hdr.tcp.seq_no[15:0].0-15
        8..11: TW3  # ingress::hdr.tcp.ack_no
        12..15: TW1
            # - bit[96..99] -> TW1 bit[31..28]: ingress::hdr.tcp.data_offset
            # - bit[100..103] -> TW1 bit[27..24]: ingress::hdr.tcp.res
            # - bit[104..111] -> TW1 bit[23..16]: ingress::hdr.tcp.flags
            # - bit[112..127] -> TW1 bit[15..0]: ingress::hdr.tcp.window
        16..19: TW2
            # - bit[128..143] -> TW2 bit[31..16]: ingress::hdr.tcp.checksum
            # - bit[144..159] -> TW2 bit[15..0]: ingress::hdr.tcp.urgent_ptr
        B7: 8  # value 1 -> B7 bit[3]: ingress::hdr.tcp.$valid
        shift: 20
        buf_req: 20
        next: end
    parse_udp:
      *:
        0..3: W2
            # - bit[0..15] -> W2 bit[31..16]: ingress::hdr.udp.src_port
            # - bit[16..31] -> W2 bit[15..0]: ingress::hdr.udp.dst_port
        4..7: TW1
            # - bit[32..47] -> TW1 bit[31..16]: ingress::hdr.udp.hdr_length
            # - bit[48..63] -> TW1 bit[15..0]: ingress::hdr.udp.checksum
        B7: 16  # value 1 -> B7 bit[4]: ingress::hdr.udp.$valid
        shift: 8
        buf_req: 8
        next: end
    parse_arp:
      match: [ half ]
      0x0001:
        0..3: TW0
            # - bit[0..15] -> TW0 bit[31..16]: ingress::hdr.arp.hw_type
            # - bit[16..31] -> TW0 bit[15..0]: ingress::hdr.arp.proto_type
        4..5: TH0
            # - bit[32..39] -> TH0 bit[15..8]: ingress::hdr.arp.hw_addr_len
            # - bit[40..47] -> TH0 bit[7..0]: ingress::hdr.arp.proto_addr_len
        6..7: H5  # ingress::hdr.arp.opcode
        B7: 32  # value 1 -> B7 bit[5]: ingress::hdr.arp.$valid
        shift: 8
        buf_req: 8
        next: parse_arp_ipv4
      0x0002:
        0..3: TW0
            # - bit[0..15] -> TW0 bit[31..16]: ingress::hdr.arp.hw_type
            # - bit[16..31] -> TW0 bit[15..0]: ingress::hdr.arp.proto_type
        4..5: TH0
            # - bit[32..39] -> TH0 bit[15..8]: ingress::hdr.arp.hw_addr_len
            # - bit[40..47] -> TH0 bit[7..0]: ingress::hdr.arp.proto_addr_len
        6..7: H5  # ingress::hdr.arp.opcode
        B7: 32  # value 1 -> B7 bit[5]: ingress::hdr.arp.$valid
        shift: 8
        buf_req: 8
        next: parse_arp_ipv4
      0x****:
        0..3: TW0
            # - bit[0..15] -> TW0 bit[31..16]: ingress::hdr.arp.hw_type
            # - bit[16..31] -> TW0 bit[15..0]: ingress::hdr.arp.proto_type
        4..5: TH0
            # - bit[32..39] -> TH0 bit[15..8]: ingress::hdr.arp.hw_addr_len
            # - bit[40..47] -> TH0 bit[7..0]: ingress::hdr.arp.proto_addr_len
        6..7: H5  # ingress::hdr.arp.opcode
        B7: 32  # value 1 -> B7 bit[5]: ingress::hdr.arp.$valid
        shift: 8
        buf_req: 8
        next: end
    parse_arp_ipv4:
      *:
        0..1: TH2  # ingress::hdr.arp_ipv4.sender_hw_addr[47:32].32-47
        2..5: TW3  # ingress::hdr.arp_ipv4.sender_hw_addr[31:0].0-31
        6..9: W0  # ingress::hdr.arp_ipv4.sender_proto_addr
        10..11: TH1  # ingress::hdr.arp_ipv4.target_hw_addr[47:32].32-47
        12..15: TW2  # ingress::hdr.arp_ipv4.target_hw_addr[31:0].0-31
        16..19: TW1  # ingress::hdr.arp_ipv4.target_proto_addr
        B7: 64  # value 1 -> B7 bit[6]: ingress::hdr.arp_ipv4.$valid
        shift: 20
        buf_req: 20
        next: end
deparser ingress:
  dictionary:
    H11: B7(0)  # ingress::hdr.reorder_digest.magic if ingress::hdr.reorder_digest.$valid
    H3: B7(0)  # ingress::hdr.reorder_digest.flow_hash if ingress::hdr.reorder_digest.$valid
    H6: B7(0)  # ingress::hdr.reorder_digest.seq if ingress::hdr.reorder_digest.$valid
    B1: B7(0)  # ingress::hdr.reorder_digest.recirc_count if ingress::hdr.reorder_digest.$valid
    B6: B7(0)  # ingress::hdr.reorder_digest.reserved if ingress::hdr.reorder_digest.$valid
    H9: B7(1)  # ingress::hdr.ethernet.dst_addr.32-47 if ingress::hdr.ethernet.$valid
    W4: B7(1)  # ingress::hdr.ethernet.dst_addr.0-31 if ingress::hdr.ethernet.$valid
    H10: B7(1)  # ingress::hdr.ethernet.src_addr.32-47 if ingress::hdr.ethernet.$valid
    W5: B7(1)  # ingress::hdr.ethernet.src_addr.0-31 if ingress::hdr.ethernet.$valid
    TH3: B7(1)  # ingress::hdr.ethernet.ether_type if ingress::hdr.ethernet.$valid
    TW0: B7(2)
        # - bit[31..28]: ingress::hdr.ipv4.version if ingress::hdr.ipv4.$valid
        # - bit[27..24]: ingress::hdr.ipv4.ihl if ingress::hdr.ipv4.$valid
        # - bit[23..16]: ingress::hdr.ipv4.diffserv if ingress::hdr.ipv4.$valid
        # - bit[15..0]: ingress::hdr.ipv4.total_len if ingress::hdr.ipv4.$valid
    H5: B7(2)  # ingress::hdr.ipv4.identification if ingress::hdr.ipv4.$valid
    TH0: B7(2)
        # - bit[15..13]: ingress::hdr.ipv4.flags if ingress::hdr.ipv4.$valid
        # - bit[12..0]: ingress::hdr.ipv4.frag_offset if ingress::hdr.ipv4.$valid
    B2: B7(2)  # ingress::hdr.ipv4.ttl if ingress::hdr.ipv4.$valid
    TB0: B7(2)  # ingress::hdr.ipv4.protocol if ingress::hdr.ipv4.$valid
    full_checksum 0: B7(2)  # ingress::hdr.ipv4.$valid
    W0: B7(2)  # ingress::hdr.ipv4.src_addr if ingress::hdr.ipv4.$valid
    W6: B7(2)  # ingress::hdr.ipv4.dst_addr if ingress::hdr.ipv4.$valid
    W2: B7(3)
        # - bit[31..16]: ingress::hdr.tcp.src_port if ingress::hdr.tcp.$valid
        # - bit[15..0]: ingress::hdr.tcp.dst_port if ingress::hdr.tcp.$valid
    TH2: B7(3)  # ingress::hdr.tcp.seq_no.16-31 if ingress::hdr.tcp.$valid
    TH1: B7(3)  # ingress::hdr.tcp.seq_no.0-15 if ingress::hdr.tcp.$valid
    TW3: B7(3)  # ingress::hdr.tcp.ack_no if ingress::hdr.tcp.$valid
    TW1: B7(3)
        # - bit[31..28]: ingress::hdr.tcp.data_offset if ingress::hdr.tcp.$valid
        # - bit[27..24]: ingress::hdr.tcp.res if ingress::hdr.tcp.$valid
        # - bit[23..16]: ingress::hdr.tcp.flags if ingress::hdr.tcp.$valid
        # - bit[15..0]: ingress::hdr.tcp.window if ingress::hdr.tcp.$valid
    TW2: B7(3)
        # - bit[31..16]: ingress::hdr.tcp.checksum if ingress::hdr.tcp.$valid
        # - bit[15..0]: ingress::hdr.tcp.urgent_ptr if ingress::hdr.tcp.$valid
    W2: B7(4)
        # - bit[31..16]: ingress::hdr.udp.src_port if ingress::hdr.udp.$valid
        # - bit[15..0]: ingress::hdr.udp.dst_port if ingress::hdr.udp.$valid
    TW1: B7(4)
        # - bit[31..16]: ingress::hdr.udp.hdr_length if ingress::hdr.udp.$valid
        # - bit[15..0]: ingress::hdr.udp.checksum if ingress::hdr.udp.$valid
    TW0: B7(5)
        # - bit[31..16]: ingress::hdr.arp.hw_type if ingress::hdr.arp.$valid
        # - bit[15..0]: ingress::hdr.arp.proto_type if ingress::hdr.arp.$valid
    TH0: B7(5)
        # - bit[15..8]: ingress::hdr.arp.hw_addr_len if ingress::hdr.arp.$valid
        # - bit[7..0]: ingress::hdr.arp.proto_addr_len if ingress::hdr.arp.$valid
    H5: B7(5)  # ingress::hdr.arp.opcode if ingress::hdr.arp.$valid
    TH2: B7(6)  # ingress::hdr.arp_ipv4.sender_hw_addr.32-47 if ingress::hdr.arp_ipv4.$valid
    TW3: B7(6)  # ingress::hdr.arp_ipv4.sender_hw_addr.0-31 if ingress::hdr.arp_ipv4.$valid
    W0: B7(6)  # ingress::hdr.arp_ipv4.sender_proto_addr if ingress::hdr.arp_ipv4.$valid
