  ig_intr_md_for_dprsr.digest_type: {  stage 1..12: B4(0..2) } 
  ig_intr_md_for_dprsr.resubmit_type: {  stage 8..12: B3(0..2) } 
  ig_intr_md_for_dprsr.mirror_type: {  stage 10..12: B5(0..2) } 
