    TW2: B7(6)  # ingress::hdr.arp_ipv4.target_hw_addr.0-31 if ingress::hdr.arp_ipv4.$valid
    TW1: B7(6)  # ingress::hdr.arp_ipv4.target_proto_addr if ingress::hdr.arp_ipv4.$valid
  partial_checksum 0: 
    - TW0: { }
        # - bit[31..28]: ingress::hdr.ipv4.version
        # - bit[27..24]: ingress::hdr.ipv4.ihl
        # - bit[23..16]: ingress::hdr.ipv4.diffserv
        # - bit[15..0]: ingress::hdr.ipv4.total_len
    - H5: { }  # ingress::hdr.ipv4.identification
    - TH0: { }
        # - bit[15..13]: ingress::hdr.ipv4.flags
        # - bit[12..0]: ingress::hdr.ipv4.frag_offset
    - B2: { swap: 1 }  # ingress::hdr.ipv4.ttl
    - TB0: { }  # ingress::hdr.ipv4.protocol
    - W0: { }  # ingress::hdr.ipv4.src_addr
    - W6: { }  # ingress::hdr.ipv4.dst_addr
  full_checksum 0: 
    - partial_checksum 0: { }
  egress_unicast_port: H1(0..8)  # bit[8..0]: ingress::ig_intr_md_for_tm.ucast_egress_port
  bypss_egr: B5(3..3)  # bit[3]: ingress::ig_intr_md_for_tm.bypass_egress
  drop_ctl: B5(0..2)  # bit[2..0]: ingress::ig_intr_md_for_dprsr.drop_ctl
