phv egress:
parser ingress:
  start: $init_match
  init_zero: [ B6, H13, W1, W3, B2, H5, H8, B5, H3, W7, B9 ]
  bitwise_or: [ B9 ]
  hdr_len_adj: 16
  states:
    $init_match:
      *:
        load: { byte1 : 0 }
        buf_req: 1
        next: $entry_point.start
    $entry_point.start:
      match: [ byte1 ]
      0b0*******:
        0..1: H2  # bit[7] -> H2 bit[8]: ingress::ig_intr_md.ingress_port[8:8].8-8
        0..1: H12  # bit[8..15] -> H12 bit[7..0]: ingress::ig_intr_md.ingress_port[7:0].0-7
        load: { half : 28..29 }
        shift: 16
        buf_req: 30
        next: parse_ethernet
      0b1*******:
        0..1: H2  # bit[7] -> H2 bit[8]: ingress::ig_intr_md.ingress_port[8:8].8-8
        0..1: H12  # bit[8..15] -> H12 bit[7..0]: ingress::ig_intr_md.ingress_port[7:0].0-7
        load: { byte1 : 8 }
        shift: 8
        buf_req: 9
        next: parse_resubmit
    parse_ethernet:
      match: [ half ]
      0x0800:
        0..1: H9  # ingress::hdr.ethernet.dst_addr[47:32].32-47
        2..5: W4  # ingress::hdr.ethernet.dst_addr[31:0].0-31
        6..7: H10  # ingress::hdr.ethernet.src_addr[47:32].32-47
        8..11: W5  # ingress::hdr.ethernet.src_addr[31:0].0-31
        12..13: TH2  # ingress::hdr.ethernet.ether_type
        B9: 1  # value 1 -> B9 bit[0]: ingress::hdr.ethernet.$valid
        load: { byte1 : 23 }
        shift: 14
        buf_req: 24
        next: parse_ipv4
      0x0806:
        0..1: H9  # ingress::hdr.ethernet.dst_addr[47:32].32-47
        2..5: W4  # ingress::hdr.ethernet.dst_addr[31:0].0-31
        6..7: H10  # ingress::hdr.ethernet.src_addr[47:32].32-47
        8..11: W5  # ingress::hdr.ethernet.src_addr[31:0].0-31
        12..13: TH2  # ingress::hdr.ethernet.ether_type
        B9: 1  # value 1 -> B9 bit[0]: ingress::hdr.ethernet.$valid
        shift: 14
        buf_req: 14
        next: parse_arp
      0x****:
        0..1: H9  # ingress::hdr.ethernet.dst_addr[47:32].32-47
        2..5: W4  # ingress::hdr.ethernet.dst_addr[31:0].0-31
        6..7: H10  # ingress::hdr.ethernet.src_addr[47:32].32-47
        8..11: W5  # ingress::hdr.ethernet.src_addr[31:0].0-31
        12..13: TH2  # ingress::hdr.ethernet.ether_type
        B9: 1  # value 1 -> B9 bit[0]: ingress::hdr.ethernet.$valid
        shift: 14
        buf_req: 14
        next: end
    parse_ipv4:
      match: [ byte1 ]
      0x06:
        0..3: TW0
            # - bit[0..3] -> TW0 bit[31..28]: ingress::hdr.ipv4.version
            # - bit[4..7] -> TW0 bit[27..24]: ingress::hdr.ipv4.ihl
            # - bit[8..15] -> TW0 bit[23..16]: ingress::hdr.ipv4.diffserv
            # - bit[16..31] -> TW0 bit[15..0]: ingress::hdr.ipv4.total_len
        4..5: H6  # ingress::hdr.ipv4.identification
        6..7: TH1
            # - bit[48..50] -> TH1 bit[15..13]: ingress::hdr.ipv4.flags
            # - bit[51..63] -> TH1 bit[12..0]: ingress::hdr.ipv4.frag_offset
        8: B0  # ingress::hdr.ipv4.ttl
        9: TB0  # ingress::hdr.ipv4.protocol
        10..11: TH3  # ingress::hdr.ipv4.hdr_checksum
        12..15: W0  # ingress::hdr.ipv4.src_addr
        16..19: W6  # ingress::hdr.ipv4.dst_addr
        B9: 2  # value 1 -> B9 bit[1]: ingress::hdr.ipv4.$valid
        shift: 20
        buf_req: 20
        next: parse_tcp
      0x11:
        0..3: TW0
            # - bit[0..3] -> TW0 bit[31..28]: ingress::hdr.ipv4.version
            # - bit[4..7] -> TW0 bit[27..24]: ingress::hdr.ipv4.ihl
            # - bit[8..15] -> TW0 bit[23..16]: ingress::hdr.ipv4.diffserv
            # - bit[16..31] -> TW0 bit[15..0]: ingress::hdr.ipv4.total_len
        4..5: H6  # ingress::hdr.ipv4.identification
        6..7: TH1
            # - bit[48..50] -> TH1 bit[15..13]: ingress::hdr.ipv4.flags
            # - bit[51..63] -> TH1 bit[12..0]: ingress::hdr.ipv4.frag_offset
        8: B0  # ingress::hdr.ipv4.ttl
        9: TB0  # ingress::hdr.ipv4.protocol
        10..11: TH3  # ingress::hdr.ipv4.hdr_checksum
        12..15: W0  # ingress::hdr.ipv4.src_addr
        16..19: W6  # ingress::hdr.ipv4.dst_addr
        B9: 2  # value 1 -> B9 bit[1]: ingress::hdr.ipv4.$valid
        shift: 20
        buf_req: 20
        next: parse_udp
      0x**:
        0..3: TW0
            # - bit[0..3] -> TW0 bit[31..28]: ingress::hdr.ipv4.version
            # - bit[4..7] -> TW0 bit[27..24]: ingress::hdr.ipv4.ihl
            # - bit[8..15] -> TW0 bit[23..16]: ingress::hdr.ipv4.diffserv
            # - bit[16..31] -> TW0 bit[15..0]: ingress::hdr.ipv4.total_len
        4..5: H6  # ingress::hdr.ipv4.identification
        6..7: TH1
            # - bit[48..50] -> TH1 bit[15..13]: ingress::hdr.ipv4.flags
            # - bit[51..63] -> TH1 bit[12..0]: ingress::hdr.ipv4.frag_offset
        8: B0  # ingress::hdr.ipv4.ttl
        9: TB0  # ingress::hdr.ipv4.protocol
        10..11: TH3  # ingress::hdr.ipv4.hdr_checksum
        12..15: W0  # ingress::hdr.ipv4.src_addr
        16..19: W6  # ingress::hdr.ipv4.dst_addr
        B9: 2  # value 1 -> B9 bit[1]: ingress::hdr.ipv4.$valid
        shift: 20
        buf_req: 20
        next: end
    parse_tcp:
      *:
        0..3: W2
            # - bit[0..15] -> W2 bit[31..16]: ingress::hdr.tcp.src_port
            # - bit[16..31] -> W2 bit[15..0]: ingress::hdr.tcp.dst_port
        4: TB2  # ingress::hdr.tcp.seq_no[31:24].24-31
        5: TB1  # ingress::hdr.tcp.seq_no[23:16].16-23
        6..7: TH0  # ingress::hdr.tcp.seq_no[15:0].0-15
        8..11: TW3  # ingress::hdr.tcp.ack_no
        12..15: TW1
            # - bit[96..99] -> TW1 bit[31..28]: ingress::hdr.tcp.data_offset
            # - bit[100..103] -> TW1 bit[27..24]: ingress::hdr.tcp.res
            # - bit[104..111] -> TW1 bit[23..16]: ingress::hdr.tcp.flags
            # - bit[112..127] -> TW1 bit[15..0]: ingress::hdr.tcp.window
        16..19: TW2
            # - bit[128..143] -> TW2 bit[31..16]: ingress::hdr.tcp.checksum
            # - bit[144..159] -> TW2 bit[15..0]: ingress::hdr.tcp.urgent_ptr
        B9: 4  # value 1 -> B9 bit[2]: ingress::hdr.tcp.$valid
        shift: 20
        buf_req: 20
        next: end
    parse_udp:
      *:
        0..3: W2
            # - bit[0..15] -> W2 bit[31..16]: ingress::hdr.udp.src_port
            # - bit[16..31] -> W2 bit[15..0]: ingress::hdr.udp.dst_port
        4..7: TW1
            # - bit[32..47] -> TW1 bit[31..16]: ingress::hdr.udp.hdr_length
            # - bit[48..63] -> TW1 bit[15..0]: ingress::hdr.udp.checksum
        B9: 8  # value 1 -> B9 bit[3]: ingress::hdr.udp.$valid
        shift: 8
        buf_req: 8
        next: end
    parse_arp:
      *:
        0..3: TW0
            # - bit[0..15] -> TW0 bit[31..16]: ingress::hdr.arp.hw_type
            # - bit[16..31] -> TW0 bit[15..0]: ingress::hdr.arp.proto_type
        4: TB1  # ingress::hdr.arp.hw_addr_len
        5: TB0  # ingress::hdr.arp.proto_addr_len
        6: B8  # ingress::hdr.arp.opcode[15:8].8-15
        7: B0  # ingress::hdr.arp.opcode[7:0].0-7
        load: { half : 6..7 }
        shift: 8
        buf_req: 8
        next: parse_arp.$split_0
    parse_arp.$split_0:
      match: [ half ]
      0x0001:
        B9: 16  # value 1 -> B9 bit[4]: ingress::hdr.arp.$valid
        buf_req: 0
        next: parse_arp_ipv4
      0x0002:
        B9: 16  # value 1 -> B9 bit[4]: ingress::hdr.arp.$valid
        buf_req: 0
        next: parse_arp_ipv4
      0x****:
        B9: 16  # value 1 -> B9 bit[4]: ingress::hdr.arp.$valid
        buf_req: 0
        next: end
    parse_arp_ipv4:
      *:
        0..1: TH1  # ingress::hdr.arp_ipv4.sender_hw_addr[47:32].32-47
        2..5: TW3  # ingress::hdr.arp_ipv4.sender_hw_addr[31:0].0-31
        6..9: W0  # ingress::hdr.arp_ipv4.sender_proto_addr
        10..11: TH0  # ingress::hdr.arp_ipv4.target_hw_addr[47:32].32-47
        12..15: TW2  # ingress::hdr.arp_ipv4.target_hw_addr[31:0].0-31
        16..19: TW1  # ingress::hdr.arp_ipv4.target_proto_addr
        B9: 32  # value 1 -> B9 bit[5]: ingress::hdr.arp_ipv4.$valid
        shift: 20
        buf_req: 20
        next: end
    parse_resubmit:
      match: [ byte1 ]
      0xff:
        0: B7  # ingress::hdr.reorder_digest.type
        1..2: H7  # ingress::hdr.reorder_digest.flow_hash
        3..4: H4  # ingress::hdr.reorder_digest.seq
        5: B1  # ingress::hdr.reorder_digest.resubmit_count
        6..7: H11  # ingress::hdr.reorder_digest.reserved
        B9: 64  # value 1 -> B9 bit[6]: ingress::hdr.reorder_digest.$valid
        load: { half : 20..21 }
        shift: 8
        buf_req: 22
        next: parse_ethernet
      0x**:
        load: { half : 12..13 }
        buf_req: 14
        next: parse_ethernet
deparser ingress:
  dictionary:
    H9: B9(0)  # ingress::hdr.ethernet.dst_addr.32-47 if ingress::hdr.ethernet.$valid
    W4: B9(0)  # ingress::hdr.ethernet.dst_addr.0-31 if ingress::hdr.ethernet.$valid
    H10: B9(0)  # ingress::hdr.ethernet.src_addr.32-47 if ingress::hdr.ethernet.$valid
    W5: B9(0)  # ingress::hdr.ethernet.src_addr.0-31 if ingress::hdr.ethernet.$valid
    TH2: B9(0)  # ingress::hdr.ethernet.ether_type if ingress::hdr.ethernet.$valid
    TW0: B9(1)
        # - bit[31..28]: ingress::hdr.ipv4.version if ingress::hdr.ipv4.$valid
        # - bit[27..24]: ingress::hdr.ipv4.ihl if ingress::hdr.ipv4.$valid
        # - bit[23..16]: ingress::hdr.ipv4.diffserv if ingress::hdr.ipv4.$valid
        # - bit[15..0]: ingress::hdr.ipv4.total_len if ingress::hdr.ipv4.$valid
    H6: B9(1)  # ingress::hdr.ipv4.identification if ingress::hdr.ipv4.$valid
    TH1: B9(1)
        # - bit[15..13]: ingress::hdr.ipv4.flags if ingress::hdr.ipv4.$valid
        # - bit[12..0]: ingress::hdr.ipv4.frag_offset if ingress::hdr.ipv4.$valid
    B0: B9(1)  # ingress::hdr.ipv4.ttl if ingress::hdr.ipv4.$valid
    TB0: B9(1)  # ingress::hdr.ipv4.protocol if ingress::hdr.ipv4.$valid
    full_checksum 0: B9(1)  # ingress::hdr.ipv4.$valid
    W0: B9(1)  # ingress::hdr.ipv4.src_addr if ingress::hdr.ipv4.$valid
    W6: B9(1)  # ingress::hdr.ipv4.dst_addr if ingress::hdr.ipv4.$valid
    W2: B9(2)
        # - bit[31..16]: ingress::hdr.tcp.src_port if ingress::hdr.tcp.$valid
        # - bit[15..0]: ingress::hdr.tcp.dst_port if ingress::hdr.tcp.$valid
    TB2: B9(2)  # ingress::hdr.tcp.seq_no.24-31 if ingress::hdr.tcp.$valid
    TB1: B9(2)  # ingress::hdr.tcp.seq_no.16-23 if ingress::hdr.tcp.$valid
    TH0: B9(2)  # ingress::hdr.tcp.seq_no.0-15 if ingress::hdr.tcp.$valid
    TW3: B9(2)  # ingress::hdr.tcp.ack_no if ingress::hdr.tcp.$valid
    TW1: B9(2)
        # - bit[31..28]: ingress::hdr.tcp.data_offset if ingress::hdr.tcp.$valid
        # - bit[27..24]: ingress::hdr.tcp.res if ingress::hdr.tcp.$valid
        # - bit[23..16]: ingress::hdr.tcp.flags if ingress::hdr.tcp.$valid
        # - bit[15..0]: ingress::hdr.tcp.window if ingress::hdr.tcp.$valid
    TW2: B9(2)
        # - bit[31..16]: ingress::hdr.tcp.checksum if ingress::hdr.tcp.$valid
        # - bit[15..0]: ingress::hdr.tcp.urgent_ptr if ingress::hdr.tcp.$valid
    W2: B9(3)
        # - bit[31..16]: ingress::hdr.udp.src_port if ingress::hdr.udp.$valid
        # - bit[15..0]: ingress::hdr.udp.dst_port if ingress::hdr.udp.$valid
    TW1: B9(3)
        # - bit[31..16]: ingress::hdr.udp.hdr_length if ingress::hdr.udp.$valid
        # - bit[15..0]: ingress::hdr.udp.checksum if ingress::hdr.udp.$valid
    TW0: B9(4)
        # - bit[31..16]: ingress::hdr.arp.hw_type if ingress::hdr.arp.$valid
        # - bit[15..0]: ingress::hdr.arp.proto_type if ingress::hdr.arp.$valid
    TB1: B9(4)  # ingress::hdr.arp.hw_addr_len if ingress::hdr.arp.$valid
    TB0: B9(4)  # ingress::hdr.arp.proto_addr_len if ingress::hdr.arp.$valid
    B8: B9(4)  # ingress::hdr.arp.opcode.8-15 if ingress::hdr.arp.$valid
    B0: B9(4)  # ingress::hdr.arp.opcode.0-7 if ingress::hdr.arp.$valid
    TH1: B9(5)  # ingress::hdr.arp_ipv4.sender_hw_addr.32-47 if ingress::hdr.arp_ipv4.$valid
    TW3: B9(5)  # ingress::hdr.arp_ipv4.sender_hw_addr.0-31 if ingress::hdr.arp_ipv4.$valid
    W0: B9(5)  # ingress::hdr.arp_ipv4.sender_proto_addr if ingress::hdr.arp_ipv4.$valid
    TH0: B9(5)  # ingress::hdr.arp_ipv4.target_hw_addr.32-47 if ingress::hdr.arp_ipv4.$valid
    TW2: B9(5)  # ingress::hdr.arp_ipv4.target_hw_addr.0-31 if ingress::hdr.arp_ipv4.$valid
    TW1: B9(5)  # ingress::hdr.arp_ipv4.target_proto_addr if ingress::hdr.arp_ipv4.$valid
  partial_checksum 0: 
    - TW0: { }
        # - bit[31..28]: ingress::hdr.ipv4.version
        # - bit[27..24]: ingress::hdr.ipv4.ihl
        # - bit[23..16]: ingress::hdr.ipv4.diffserv
        # - bit[15..0]: ingress::hdr.ipv4.total_len
    - H6: { }  # ingress::hdr.ipv4.identification
    - TH1: { }
        # - bit[15..13]: ingress::hdr.ipv4.flags
        # - bit[12..0]: ingress::hdr.ipv4.frag_offset
    - B0: { swap: 1 }  # ingress::hdr.ipv4.ttl
    - TB0: { }  # ingress::hdr.ipv4.protocol
    - W0: { }  # ingress::hdr.ipv4.src_addr
    - W6: { }  # ingress::hdr.ipv4.dst_addr
  full_checksum 0: 
    - partial_checksum 0: { }
  egress_unicast_port: H1(0..8)  # bit[8..0]: ingress::ig_intr_md_for_tm.ucast_egress_port
  bypss_egr: B6(3..3)  # bit[3]: ingress::ig_intr_md_for_tm.bypass_egress
  drop_ctl: B6(0..2)  # bit[2..0]: ingress::ig_intr_md_for_dprsr.drop_ctl
  egress_multicast_group_0:
    - H0  # ingress::ig_intr_md_for_tm.mcast_grp_a
  learning:
    select: B4(0..2)  # bit[2..0]: ingress::ig_intr_md_for_dprsr.digest_type
    1:
      - B4(0..2)  # bit[2..0]: ingress::ig_intr_md_for_dprsr.digest_type
      - H10  # ingress::hdr.ethernet.src_addr.32-47
      - W5  # ingress::hdr.ethernet.src_addr.0-31
      - W1  # ingress::ig_md.learn_src_ip
      - H13(0..8)  # bit[8..0]: ingress::ig_md.ingress_port
    context_json:
      1:
        - [ hdr.ethernet.src_addr, 1, 16, 7, 32]
        - [ hdr.ethernet.src_addr, 3, 32, 7, 0]
        - [ ig_md.learn_src_ip, 7, 32, 7, 0]
        - [ ig_md.ingress_port, 11, 9, 0, 0]
      name: [ SwitchIngressDeparser.learn_digest ]
  mirror:
    select: B5(0..2)  # bit[2..0]: ingress::ig_intr_md_for_dprsr.mirror_type
    0:
      - H2(0..9)  # bit[9..0]: ingress::$tmp2
  resubmit:
    select: B3(0..2)  # bit[2..0]: ingress::ig_intr_md_for_dprsr.resubmit_type
    2:
