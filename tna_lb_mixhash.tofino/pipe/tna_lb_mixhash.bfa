        # - bit[15..8]: ingress::hdr.arp.hw_addr_len if ingress::hdr.arp.$valid
        # - bit[7..0]: ingress::hdr.arp.proto_addr_len if ingress::hdr.arp.$valid
    H4: B7(6)  # ingress::hdr.arp.opcode if ingress::hdr.arp.$valid
    TH4: B7(7)  # ingress::hdr.arp_ipv4.sender_hw_addr.32-47 if ingress::hdr.arp_ipv4.$valid
    TH2: B7(7)  # ingress::hdr.arp_ipv4.sender_hw_addr.16-31 if ingress::hdr.arp_ipv4.$valid
    TH1: B7(7)  # ingress::hdr.arp_ipv4.sender_hw_addr.0-15 if ingress::hdr.arp_ipv4.$valid
    W0: B7(7)  # ingress::hdr.arp_ipv4.sender_proto_addr if ingress::hdr.arp_ipv4.$valid
    TH3: B7(7)  # ingress::hdr.arp_ipv4.target_hw_addr.32-47 if ingress::hdr.arp_ipv4.$valid
    TW2: B7(7)  # ingress::hdr.arp_ipv4.target_hw_addr.0-31 if ingress::hdr.arp_ipv4.$valid
    TW1: B7(7)  # ingress::hdr.arp_ipv4.target_proto_addr if ingress::hdr.arp_ipv4.$valid
  partial_checksum 0: 
    - TW0: { }
        # - bit[31..28]: ingress::hdr.ipv4.version
        # - bit[27..24]: ingress::hdr.ipv4.ihl
        # - bit[23..16]: ingress::hdr.ipv4.diffserv
        # - bit[15..0]: ingress::hdr.ipv4.total_len
    - H6: { }  # ingress::hdr.ipv4.identification
    - TH1: { }
        # - bit[15..13]: ingress::hdr.ipv4.flags
        # - bit[12..0]: ingress::hdr.ipv4.frag_offset
    - B2: { swap: 1 }  # ingress::hdr.ipv4.ttl
    - TB0: { }  # ingress::hdr.ipv4.protocol
    - W0: { }  # ingress::hdr.ipv4.src_addr
    - W6: { }  # ingress::hdr.ipv4.dst_addr
  full_checksum 0: 
    - partial_checksum 0: { }
  egress_unicast_port: H1(0..8)  # bit[8..0]: ingress::ig_intr_md_for_tm.ucast_egress_port
  bypss_egr: B5(3..3)  # bit[3]: ingress::ig_intr_md_for_tm.bypass_egress
  drop_ctl: B5(0..2)  # bit[2..0]: ingress::ig_intr_md_for_dprsr.drop_ctl
  egress_multicast_group_0:
    - H0  # ingress::ig_intr_md_for_tm.mcast_grp_a
  learning:
    select: B3(0..2)  # bit[2..0]: ingress::ig_intr_md_for_dprsr.digest_type
    1:
      - B3(0..2)  # bit[2..0]: ingress::ig_intr_md_for_dprsr.digest_type
      - H10  # ingress::hdr.ethernet.src_addr.32-47
      - W5  # ingress::hdr.ethernet.src_addr.0-31
      - W1  # ingress::ig_md.learn_src_ip
      - H13(0..8)  # bit[8..0]: ingress::ig_md.ingress_port
    context_json:
      1:
        - [ hdr.ethernet.src_addr, 1, 16, 7, 32]
        - [ hdr.ethernet.src_addr, 3, 32, 7, 0]
        - [ ig_md.learn_src_ip, 7, 32, 7, 0]
        - [ ig_md.ingress_port, 11, 9, 0, 0]
      name: [ SwitchIngressDeparser.learn_digest ]
  mirror:
    select: B4(0..2)  # bit[2..0]: ingress::ig_intr_md_for_dprsr.mirror_type
    0:
      - H2(0..9)  # bit[9..0]: ingress::$tmp2
