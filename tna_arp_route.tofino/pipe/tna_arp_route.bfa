version:
  version: 1.0.1
  run_id: "cf8db9334aa04ab4"
  target: Tofino
error_mode: propagate_and_disable
phv ingress:
  ig_intr_md.ingress_port: {  stage 0: H5(0..8) } 
  hdr.ethernet.dst_addr.0-31: W2
  hdr.ethernet.dst_addr.32-47: H3
  hdr.ethernet.src_addr.0-31: W3
  hdr.ethernet.src_addr.32-47: H4
  hdr.ethernet.ether_type: TH0
  hdr.ipv4.version: TW0(28..31)
  hdr.ipv4.ihl: TW0(24..27)
  hdr.ipv4.diffserv: TW0(16..23)
  hdr.ipv4.total_len: TW0(0..15)
  hdr.ipv4.identification: TW1(16..31)
  hdr.ipv4.flags: TW1(13..15)
  hdr.ipv4.frag_offset: TW1(0..12)
  hdr.ipv4.ttl: B0
  hdr.ipv4.protocol: TB0
  hdr.ipv4.hdr_checksum: TH1
  hdr.ipv4.src_addr: W0
  hdr.ipv4.dst_addr: W4
  hdr.arp.hw_type: TW0(16..31)
  hdr.arp.proto_type: TW0(0..15)
  hdr.arp.hw_addr_len: TB1
  hdr.arp.proto_addr_len: TB0
  hdr.arp.opcode.0-7: B0
  hdr.arp.opcode.8-15: B4
  hdr.arp_ipv4.sender_hw_addr.0-31: TW3
  hdr.arp_ipv4.sender_hw_addr.32-47: TH2
  hdr.arp_ipv4.sender_proto_addr: W0
  hdr.arp_ipv4.target_hw_addr.0-31: TW2
  hdr.arp_ipv4.target_hw_addr.32-47: TH1
  hdr.arp_ipv4.target_proto_addr: TW1
  ig_md.ingress_port: {  stage 1..12: H6(0..8) } 
  ig_md.learn_src_ip: {  stage 1..12: W1 } 
  ig_intr_md_for_dprsr.drop_ctl: {  stage 2..12: B3(0..2) } 
  ig_intr_md_for_dprsr.digest_type: {  stage 1..12: B1(0..2) } 
  ig_intr_md_for_dprsr.mirror_type: {  stage 12: B2(0..2) } 
  ig_intr_md_for_tm.ucast_egress_port: {  stage 1..12: H1(0..8) } 
  ig_intr_md_for_tm.bypass_egress: {  stage 1..12: B3(3) } 
  ig_intr_md_for_tm.mcast_grp_a: {  stage 1..12: H0 } 
  $tmp2: {  stage 12: H2(0..9) } 
  hdr.ethernet.$valid: B5(0)
  hdr.ipv4.$valid: B5(1)
  hdr.arp.$valid: B5(2)
  hdr.arp_ipv4.$valid: B5(3)
phv egress:
parser ingress:
  start: $init_match
  init_zero: [ H6, W1, B3, B2, H2, B5 ]
  bitwise_or: [ B5 ]
  hdr_len_adj: 16
  states:
    $init_match:
      *:
        load: { byte1 : 0 }
        buf_req: 1
        next: $entry_point.start
    $entry_point.start:
      match: [ byte1 ]
      0b1*******:
        0..1: H5  # bit[7..15] -> H5 bit[8..0]: ingress::ig_intr_md.ingress_port
        shift: 8
        buf_req: 8
        next: end
      0b0*******:
        0..1: H5  # bit[7..15] -> H5 bit[8..0]: ingress::ig_intr_md.ingress_port
        16..17: H3  # ingress::hdr.ethernet.dst_addr[47:32].32-47
        18..21: W2  # ingress::hdr.ethernet.dst_addr[31:0].0-31
        22..23: H4  # ingress::hdr.ethernet.src_addr[47:32].32-47
        24..27: W3  # ingress::hdr.ethernet.src_addr[31:0].0-31
        28..29: TH0  # ingress::hdr.ethernet.ether_type
        B5: 1  # value 1 -> B5 bit[0]: ingress::hdr.ethernet.$valid
        load: { half : 28..29 }
        shift: 30
        buf_req: 30
        next: TofinoIngressParser_parse_port_metadata
    TofinoIngressParser_parse_port_metadata:
      match: [ half ]
      0x0800:
        0..3: TW0
            # - bit[0..3] -> TW0 bit[31..28]: ingress::hdr.ipv4.version
            # - bit[4..7] -> TW0 bit[27..24]: ingress::hdr.ipv4.ihl
            # - bit[8..15] -> TW0 bit[23..16]: ingress::hdr.ipv4.diffserv
            # - bit[16..31] -> TW0 bit[15..0]: ingress::hdr.ipv4.total_len
        4..7: TW1
            # - bit[32..47] -> TW1 bit[31..16]: ingress::hdr.ipv4.identification
            # - bit[48..50] -> TW1 bit[15..13]: ingress::hdr.ipv4.flags
            # - bit[51..63] -> TW1 bit[12..0]: ingress::hdr.ipv4.frag_offset
        8: B0  # ingress::hdr.ipv4.ttl
        9: TB0  # ingress::hdr.ipv4.protocol
        10..11: TH1  # ingress::hdr.ipv4.hdr_checksum
        12..15: W0  # ingress::hdr.ipv4.src_addr
        16..19: W4  # ingress::hdr.ipv4.dst_addr
        B5: 2  # value 1 -> B5 bit[1]: ingress::hdr.ipv4.$valid
        shift: 20
        buf_req: 20
        next: end
      0x0806:
        0..3: TW0
            # - bit[0..15] -> TW0 bit[31..16]: ingress::hdr.arp.hw_type
            # - bit[16..31] -> TW0 bit[15..0]: ingress::hdr.arp.proto_type
        4: TB1  # ingress::hdr.arp.hw_addr_len
        5: TB0  # ingress::hdr.arp.proto_addr_len
        6: B4  # ingress::hdr.arp.opcode[15:8].8-15
        7: B0  # ingress::hdr.arp.opcode[7:0].0-7
        load: { half : 6..7 }
        shift: 8
        buf_req: 8
        next: parse_arp.$split_0
      0x****:
        buf_req: 0
        next: end
    parse_arp.$split_0:
      match: [ half ]
      0x0001:
        B5: 4  # value 1 -> B5 bit[2]: ingress::hdr.arp.$valid
        buf_req: 0
        next: parse_arp_ipv4
      0x0002:
        B5: 4  # value 1 -> B5 bit[2]: ingress::hdr.arp.$valid
        buf_req: 0
        next: parse_arp_ipv4
      0x****:
        B5: 4  # value 1 -> B5 bit[2]: ingress::hdr.arp.$valid
        buf_req: 0
        next: end
    parse_arp_ipv4:
      *:
        0..1: TH2  # ingress::hdr.arp_ipv4.sender_hw_addr[47:32].32-47
        2..5: TW3  # ingress::hdr.arp_ipv4.sender_hw_addr[31:0].0-31
        6..9: W0  # ingress::hdr.arp_ipv4.sender_proto_addr
        10..11: TH1  # ingress::hdr.arp_ipv4.target_hw_addr[47:32].32-47
        12..15: TW2  # ingress::hdr.arp_ipv4.target_hw_addr[31:0].0-31
        16..19: TW1  # ingress::hdr.arp_ipv4.target_proto_addr
        B5: 8  # value 1 -> B5 bit[3]: ingress::hdr.arp_ipv4.$valid
        shift: 20
        buf_req: 20
        next: end
deparser ingress:
  dictionary:
    H3: B5(0)  # ingress::hdr.ethernet.dst_addr.32-47 if ingress::hdr.ethernet.$valid
    W2: B5(0)  # ingress::hdr.ethernet.dst_addr.0-31 if ingress::hdr.ethernet.$valid
    H4: B5(0)  # ingress::hdr.ethernet.src_addr.32-47 if ingress::hdr.ethernet.$valid
    W3: B5(0)  # ingress::hdr.ethernet.src_addr.0-31 if ingress::hdr.ethernet.$valid
    TH0: B5(0)  # ingress::hdr.ethernet.ether_type if ingress::hdr.ethernet.$valid
    TW0: B5(1)
        # - bit[31..28]: ingress::hdr.ipv4.version if ingress::hdr.ipv4.$valid
        # - bit[27..24]: ingress::hdr.ipv4.ihl if ingress::hdr.ipv4.$valid
        # - bit[23..16]: ingress::hdr.ipv4.diffserv if ingress::hdr.ipv4.$valid
        # - bit[15..0]: ingress::hdr.ipv4.total_len if ingress::hdr.ipv4.$valid
    TW1: B5(1)
        # - bit[31..16]: ingress::hdr.ipv4.identification if ingress::hdr.ipv4.$valid
        # - bit[15..13]: ingress::hdr.ipv4.flags if ingress::hdr.ipv4.$valid
        # - bit[12..0]: ingress::hdr.ipv4.frag_offset if ingress::hdr.ipv4.$valid
    B0: B5(1)  # ingress::hdr.ipv4.ttl if ingress::hdr.ipv4.$valid
    TB0: B5(1)  # ingress::hdr.ipv4.protocol if ingress::hdr.ipv4.$valid
    full_checksum 0: B5(1)  # ingress::hdr.ipv4.$valid
    W0: B5(1)  # ingress::hdr.ipv4.src_addr if ingress::hdr.ipv4.$valid
    W4: B5(1)  # ingress::hdr.ipv4.dst_addr if ingress::hdr.ipv4.$valid
    TW0: B5(2)
        # - bit[31..16]: ingress::hdr.arp.hw_type if ingress::hdr.arp.$valid
        # - bit[15..0]: ingress::hdr.arp.proto_type if ingress::hdr.arp.$valid
    TB1: B5(2)  # ingress::hdr.arp.hw_addr_len if ingress::hdr.arp.$valid
    TB0: B5(2)  # ingress::hdr.arp.proto_addr_len if ingress::hdr.arp.$valid
    B4: B5(2)  # ingress::hdr.arp.opcode.8-15 if ingress::hdr.arp.$valid
    B0: B5(2)  # ingress::hdr.arp.opcode.0-7 if ingress::hdr.arp.$valid
    TH2: B5(3)  # ingress::hdr.arp_ipv4.sender_hw_addr.32-47 if ingress::hdr.arp_ipv4.$valid
    TW3: B5(3)  # ingress::hdr.arp_ipv4.sender_hw_addr.0-31 if ingress::hdr.arp_ipv4.$valid
    W0: B5(3)  # ingress::hdr.arp_ipv4.sender_proto_addr if ingress::hdr.arp_ipv4.$valid
    TH1: B5(3)  # ingress::hdr.arp_ipv4.target_hw_addr.32-47 if ingress::hdr.arp_ipv4.$valid
    TW2: B5(3)  # ingress::hdr.arp_ipv4.target_hw_addr.0-31 if ingress::hdr.arp_ipv4.$valid
    TW1: B5(3)  # ingress::hdr.arp_ipv4.target_proto_addr if ingress::hdr.arp_ipv4.$valid
  partial_checksum 0: 
    - TW0: { }
        # - bit[31..28]: ingress::hdr.ipv4.version
        # - bit[27..24]: ingress::hdr.ipv4.ihl
        # - bit[23..16]: ingress::hdr.ipv4.diffserv
        # - bit[15..0]: ingress::hdr.ipv4.total_len
    - TW1: { }
        # - bit[31..16]: ingress::hdr.ipv4.identification
        # - bit[15..13]: ingress::hdr.ipv4.flags
        # - bit[12..0]: ingress::hdr.ipv4.frag_offset
    - B0: { swap: 1 }  # ingress::hdr.ipv4.ttl
    - TB0: { }  # ingress::hdr.ipv4.protocol
    - W0: { }  # ingress::hdr.ipv4.src_addr
    - W4: { }  # ingress::hdr.ipv4.dst_addr
  full_checksum 0: 
    - partial_checksum 0: { }
  egress_unicast_port: H1(0..8)  # bit[8..0]: ingress::ig_intr_md_for_tm.ucast_egress_port
  bypss_egr: B3(3..3)  # bit[3]: ingress::ig_intr_md_for_tm.bypass_egress
  drop_ctl: B3(0..2)  # bit[2..0]: ingress::ig_intr_md_for_dprsr.drop_ctl
  egress_multicast_group_0:
    - H0  # ingress::ig_intr_md_for_tm.mcast_grp_a
  learning:
    select: B1(0..2)  # bit[2..0]: ingress::ig_intr_md_for_dprsr.digest_type
    1:
      - B1(0..2)  # bit[2..0]: ingress::ig_intr_md_for_dprsr.digest_type
      - H4  # ingress::hdr.ethernet.src_addr.32-47
      - W3  # ingress::hdr.ethernet.src_addr.0-31
      - W1  # ingress::ig_md.learn_src_ip
      - H6(0..8)  # bit[8..0]: ingress::ig_md.ingress_port
    context_json:
      1:
        - [ hdr.ethernet.src_addr, 1, 16, 7, 32]
        - [ hdr.ethernet.src_addr, 3, 32, 7, 0]
        - [ ig_md.learn_src_ip, 7, 32, 7, 0]
        - [ ig_md.ingress_port, 11, 9, 0, 0]
      name: [ SwitchIngressDeparser.learn_digest ]
  mirror:
    select: B2(0..2)  # bit[2..0]: ingress::ig_intr_md_for_dprsr.mirror_type
    0:
      - H2(0..9)  # bit[9..0]: ingress::$tmp2
parser egress:
  start: $entry_point.start
  hdr_len_adj: 0
  meta_opt: 0
  states:
    $entry_point.start:
      *:
        buf_req: 0
        next: end
deparser egress:
  dictionary: {}
stage 0 ingress:
  phase0_match SwitchIngressParser.$PORT_METADATA:
    p4:
      name: SwitchIngressParser.$PORT_METADATA
      size: 288
      preferred_match_type: exact
      match_type: exact
    size: 288
    p4_param_order:
      ig_intr_md.ingress_port: { type: exact, size: 9 }
    format: {ig_intr_md: 0..63}
    constant_value: 0
    actions:
      set_port_metadata:
      - handle: 0x20000000
      - p4_param_order: { ig_intr_md: 64 } 
  ternary_match tbl_tna_arp_route232 0:
    p4: { name: tbl_tna_arp_route232, hidden: true }
    hit: [  tbl_tna_arp_route207 ]
    miss:  tbl_tna_arp_route207
    indirect: tbl_tna_arp_route232$tind
  ternary_indirect tbl_tna_arp_route232$tind:
    row: 2
    bus: 0
    format: { action: 0..0 }
    instruction: tbl_tna_arp_route232$tind(action, $DEFAULT)
    actions:
      tna_arp_route232(0, 1):
      - hit_allowed: { allowed: true }
      - default_action: { allowed: true, is_constant: true }
      - handle: 0x2000000d
      - next_table: 0
      - set ig_intr_md_for_tm.bypass_egress, 1
    default_action: tna_arp_route232
  ternary_match tbl_tna_arp_route207 1:
    p4: { name: tbl_tna_arp_route207, hidden: true }
    hit: [  tbl_tna_arp_route210 ]
    miss:  tbl_tna_arp_route210
    indirect: tbl_tna_arp_route207$tind
  ternary_indirect tbl_tna_arp_route207$tind:
    row: 1
    bus: 1
    format: { action: 0..0 }
    instruction: tbl_tna_arp_route207$tind(action, $DEFAULT)
    actions:
      tna_arp_route207(0, 2):
      - hit_allowed: { allowed: true }
      - default_action: { allowed: true, is_constant: true }
      - handle: 0x20000001
      - next_table: 0
      - set ig_md.ingress_port, ig_intr_md.ingress_port
    default_action: tna_arp_route207
  ternary_match tbl_tna_arp_route210 2:
    p4: { name: tbl_tna_arp_route210, hidden: true }
    gateway:
      name: cond-4
      input_xbar:
        exact group 0: { 2: hdr.arp.$valid }
      row: 0
      bus: 0
      unit: 0
      match: { 2: hdr.arp.$valid }
      0x1:
        run_table: true
      miss:
        next:  smac_table_0
      condition: 
        expression: "(hdr.arp.$valid == 1)"
        true:  tbl_tna_arp_route210
        false:  smac_table_0
    hit: [  tbl_tna_arp_route214 ]
    miss:  tbl_tna_arp_route214
    indirect: tbl_tna_arp_route210$tind
  ternary_indirect tbl_tna_arp_route210$tind:
    row: 1
    bus: 0
    format: { action: 0..0 }
    instruction: tbl_tna_arp_route210$tind(action, $DEFAULT)
    actions:
      tna_arp_route210(1, 3):
      - hit_allowed: { allowed: true }
      - default_action: { allowed: true, is_constant: true }
      - handle: 0x20000002
      - next_table: 0
      - set ig_intr_md_for_dprsr.digest_type, 1
      - set ig_md.learn_src_ip, hdr.arp_ipv4.sender_proto_addr
    default_action: tna_arp_route210
  exact_match smac_table_0 3:
    p4: { name: SwitchIngress.smac_table, size: 1024 }
    p4_param_order: 
      hdr.ethernet.src_addr: { type: exact, size: 48, full_size: 48 }
      hdr.ipv4.src_addr: { type: exact, size: 32, full_size: 32 }
    row: 7
    bus: 0
    column: [ 2, 3, 4, 5 ]
    stash: 
      row: [ 7 ]
      col: [ 2 ]
      unit: [ 0 ]
    ways:
      - { group: 0, index: 0..9, select: 40..51 & 0x0, rams: [[7, 2]] }
      - { group: 0, index: 10..19, select: 40..51 & 0x0, rams: [[7, 3]] }
      - { group: 0, index: 20..29, select: 40..51 & 0x0, rams: [[7, 4]] }
      - { group: 0, index: 30..39, select: 40..51 & 0x0, rams: [[7, 5]] }
    input_xbar:
      exact group 0: { 8: hdr.ipv4.src_addr(8..31), 32: hdr.ipv4.src_addr(0..7), 40: hdr.ethernet.src_addr.0-31(8..31), 64: hdr.ethernet.src_addr.0-31(0..7), 72: hdr.ethernet.src_addr.32-47(8..15), 80: hdr.ethernet.src_addr.32-47(0..7) }
      hash 0:
        0..9: random(hdr.ipv4.src_addr(8..31), hdr.ipv4.src_addr(0..7), hdr.ethernet.src_addr.0-31(8..31))
        10..19: random(hdr.ipv4.src_addr(8..31), hdr.ipv4.src_addr(0..7), hdr.ethernet.src_addr.0-31(8..31))
        20..29: random(hdr.ipv4.src_addr(8..31), hdr.ipv4.src_addr(0..7), hdr.ethernet.src_addr.0-31(8..31))
        30..39: random(hdr.ipv4.src_addr(8..31), hdr.ipv4.src_addr(0..7), hdr.ethernet.src_addr.0-31(8..31))
      hash 1:
        0..1: random(hdr.ethernet.src_addr.0-31(0..7), hdr.ethernet.src_addr.32-47(10..15)) ^ hdr.ethernet.src_addr.32-47(8..9)
        2..9: random(hdr.ethernet.src_addr.0-31(0..7), hdr.ethernet.src_addr.32-47(10..15)) ^ hdr.ethernet.src_addr.32-47(0..7)
        11..12: random(hdr.ethernet.src_addr.0-31(0..7), hdr.ethernet.src_addr.32-47(10..15)) ^ hdr.ethernet.src_addr.32-47(8..9)
        13..19: random(hdr.ethernet.src_addr.0-31(0..7), hdr.ethernet.src_addr.32-47(10..15)) ^ hdr.ethernet.src_addr.32-47(0..6)
        10: random(hdr.ethernet.src_addr.0-31(0..7), hdr.ethernet.src_addr.32-47(10..15)) ^ hdr.ethernet.src_addr.32-47(7)
        22..23: random(hdr.ethernet.src_addr.0-31(0..7), hdr.ethernet.src_addr.32-47(10..15)) ^ hdr.ethernet.src_addr.32-47(8..9)
        24..29: random(hdr.ethernet.src_addr.0-31(0..7), hdr.ethernet.src_addr.32-47(10..15)) ^ hdr.ethernet.src_addr.32-47(0..5)
        20..21: random(hdr.ethernet.src_addr.0-31(0..7), hdr.ethernet.src_addr.32-47(10..15)) ^ hdr.ethernet.src_addr.32-47(6..7)
        33..34: random(hdr.ethernet.src_addr.0-31(0..7), hdr.ethernet.src_addr.32-47(10..15)) ^ hdr.ethernet.src_addr.32-47(8..9)
        35..39: random(hdr.ethernet.src_addr.0-31(0..7), hdr.ethernet.src_addr.32-47(10..15)) ^ hdr.ethernet.src_addr.32-47(0..4)
        30..32: random(hdr.ethernet.src_addr.0-31(0..7), hdr.ethernet.src_addr.32-47(10..15)) ^ hdr.ethernet.src_addr.32-47(5..7)
