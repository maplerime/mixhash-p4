      - p4_param_order: { port: 9 }
      - hit_allowed: { allowed: true }
      - default_action: { allowed: false, reason: has_const_default_action }
      - handle: 0x20000008
      - next_table: 0
      SwitchIngress.nop(-1, 4):
      - hit_allowed: { allowed: false, reason: user_indicated_default_only }
      - default_only_action: { allowed: true, is_constant: true }
      - handle: 0x20000009
      - next_table: 0
    default_only_action: SwitchIngress.nop
  ternary_match tbl_tna_arp_route220 4:
    p4: { name: tbl_tna_arp_route220, hidden: true }
    hit: [  ipv4_route_0 ]
    miss:  ipv4_route_0
    indirect: tbl_tna_arp_route220$tind
  ternary_indirect tbl_tna_arp_route220$tind:
    row: 0
    bus: 1
    format: { action: 0..0 }
    instruction: tbl_tna_arp_route220$tind(action, $DEFAULT)
    actions:
      tna_arp_route220(0, 5):
      - hit_allowed: { allowed: true }
      - default_action: { allowed: true, is_constant: true }
      - handle: 0x20000007
      - next_table: 0
