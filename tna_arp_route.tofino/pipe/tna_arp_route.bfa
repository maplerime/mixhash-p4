  ternary_match ipv4_route_0 5:
    p4: { name: SwitchIngress.ipv4_route, size: 1024 }
    p4_param_order: 
      hdr.ipv4.dst_addr: { type: lpm, size: 32, full_size: 32 }
    row: [ 0, 1 ]
    bus: [ 0, 0 ]
    column:
    - 0
