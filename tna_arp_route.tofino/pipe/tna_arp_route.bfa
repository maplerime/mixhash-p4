    format: { action(0): 0..0, version(0): 112..115, match(0): [ 98..103, 32..95 ] }
    match: [ hdr.ethernet.src_addr.32-47(10..15), hdr.ipv4.src_addr(0..7), hdr.ipv4.src_addr(8..15), hdr.ipv4.src_addr(16..23), hdr.ipv4.src_addr(24..31), hdr.ethernet.src_addr.0-31(0..7), hdr.ethernet.src_addr.0-31(8..15), hdr.ethernet.src_addr.0-31(16..23), hdr.ethernet.src_addr.0-31(24..31) ]
    match_group_map: [ [ 0 ] ]
    gateway:
